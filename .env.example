# Servidor
PORT=3000

# Origen del frontend (local: mismo host que Express)
FRONTEND_ORIGIN=http://localhost:3000

# Auth0 — Application SPA (valores públicos en el navegador vía /auth-config)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-public-client-id

# Emisor y API (access token). El audience no es una página web alojada.
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://una-chat-api

# URL pública del socket (local = mismo origen; en Vercel = https://<VERCEL_DOMAIN>)
SOCKET_PUBLIC_URL=http://localhost:3000

# Opcional: Redis (Upstash u otro) para fan-out Socket.IO entre instancias en Vercel.
# Sin REDIS_URL el chat funciona en un solo proceso (local). En producción multi-instancia es necesario.
# REDIS_URL=rediss://default:TOKEN@HOST:6379

# Solo pruebas automatizadas: clave pública PEM (RS256) en lugar de JWKS remoto.
# AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
